{
    // ===========================================================================
    // LANGUAGE-SPECIFIC FORMATTERS
    // ===========================================================================
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.tabSize": 2
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnType": true,
        "diffEditor.ignoreTrimWhitespace": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[django-html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[helm]": {
        "editor.tabSize": 2,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // ===========================================================================
    // EDITOR CORE
    // ===========================================================================
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.defaultColorDecorators": "auto",
    "editor.detectIndentation": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.guides.bracketPairs": "active",
    "editor.insertSpaces": true,
    "editor.linkedEditing": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.tabSize": 4,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    // Font with cross-platform fallbacks (Mac + Linux)
    "editor.fontFamily": "JetBrains Mono, Menlo, 'DejaVu Sans Mono', monospace",
    "editor.letterSpacing": 0.5,
    // ===========================================================================
    // FILES & WORKSPACE
    // ===========================================================================
    "files.autoSave": "afterDelay",
    "files.associations": {
        "*.py": "python",
        "*.tsx": "typescriptreact",
        "*.js": "javascript",
        "*.ts": "typescript"
    },
    "files.watcherExclude": {
        "/.ammonite": true,
        "/.bloop": true,
        "**/.metals": true
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "search.showLineNumbers": true,
    // ===========================================================================
    // WORKBENCH / UI
    // ===========================================================================
    "workbench.colorTheme": "Cobalt2",
    "workbench.iconTheme": "vscode-icons",
    "workbench.editor.splitInGroupLayout": "vertical",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.parquet": "default",
        "file:/**/*.csv": "jupyter-data-wrangler"
    },
    "window.commandCenter": false,
    "window.customTitleBarVisibility": "auto",
    "zenMode.hideLineNumbers": false,
    "notebook.lineNumbers": "on",
    // Uncomment if you want everything (including quick open) visually bigger:
    // "window.zoomLevel": 1,
    // ===========================================================================
    // TERMINAL — cross-platform (Mac + Linux)
    // ===========================================================================
    "terminal.integrated.fontFamily": "MesloLGS NF, 'DejaVu Sans Mono', monospace",
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExit",
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.env.osx": {
        "FIG_NEW_SESSION": "1"
    },
    "terminal.integrated.env.linux": {
        "EDITOR": "nvim"
    },
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash"
        }
    },
    // ===========================================================================
    // GIT / GITLENS
    // ===========================================================================
    "git.autofetch": true,
    "git.confirmSync": true,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "gitlens.launchpad.indicator.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    // ===========================================================================
    // PYTHON
    // ===========================================================================
    "python.languageServer": "Pylance",
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.indexing": false,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.formatting.blackPath": "autopep8",
    "python.formatting.provider": "none",
    "python.diagnostics.sourceMapsEnabled": true,
    "python.defaultInterpreterPath": "/bin/python3",
    "python.terminal.activateEnvironment": false,
    "autopep8.args": [
        "--max-line-length=120"
    ],
    // ===========================================================================
    // TYPESCRIPT / JAVASCRIPT
    // ===========================================================================
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "prettier.tabWidth": 4,
    "prettier.useTabs": true,
    "json.schemas": [],
    // ===========================================================================
    // KUBERNETES (Linux paths used at FTEL workstation, ignored on Mac)
    // ===========================================================================
    "vs-kubernetes": {
        "vscode-kubernetes.helm-path-linux": "/home/longhd/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
        "vscode-kubernetes.kubectl-path-linux": "/home/longhd/.local/state/vs-kubernetes/tools/kubectl/kubectl",
        "vscode-kubernetes.minikube-path-linux": "/home/longhd/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube"
    },
    "makefile.configureOnOpen": true,
    "debug.onTaskErrors": "abort",
    "protobuf.protoc.path": "/home/longhd/.config/Code/User/globalStorage/drblury.protobuf-vsc/bin/protoc",
    // ===========================================================================
    // SECURITY / TELEMETRY / MISC
    // ===========================================================================
    "security.workspace.trust.untrustedFiles": "newWindow",
    "redhat.telemetry.enabled": true,
    "vsicons.dontShowNewVersionMessage": true,
    "tabnine.experimentalAutoImports": true,
    "docker.extension.enableComposeLanguageServer": false,
    "database-client.autoSync": true,
    "remote.autoForwardPortsSource": "hybrid",
    "remote.SSH.connectTimeout": 1800,
    "remote.SSH.remotePlatform": {
        "coder-vscode.coder.csoc.fpt.net--longhd14--CodeDeck.main": "linux"
    },
    // ===========================================================================
    // GITHUB COPILOT
    // ===========================================================================
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": true
    },
    // ===========================================================================
    // CLAUDE CODE
    // ===========================================================================
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "default",
    "chat.viewSessions.orientation": "stacked",
    // ===========================================================================
    // VIM — core options
    // ===========================================================================
    "vim.leader": "<Space>",
    "vim.useSystemClipboard": true,
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.sneak": true,
    "vim.smartRelativeLine": false,
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-i>": false,
        "<C-d>": false,
        "<C-c>": false,
        "<C-x>": false,
        "<C-v>": false,
        "<C-z>": false,
        "<C-y>": false
    },
    // ===========================================================================
    // VIM — normal mode bindings
    // (All <leader>* bindings moved into whichkey.bindings below)
    // ===========================================================================
    "vim.normalModeKeyBindingsNonRecursive": [
        // ----- Whichkey trigger -----
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        },
        // ----- Navigation history (fixed: <C-i> for forward, vim convention) -----
        {
            "before": [
                "<C-o>"
            ],
            "commands": [
                "workbench.action.navigateBack"
            ]
        },
        {
            "before": [
                "<C-i>"
            ],
            "commands": [
                "workbench.action.navigateForward"
            ]
        },
        // ----- Vertical motion with centering -----
        // Plain j/k stay normal (no auto-zz — that broke scrolling).
        // Big jumps + search results center the cursor.
        {
            "before": [
                "J"
            ],
            "after": [
                "5",
                "j",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "5",
                "k",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<C-d>",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "<C-u>"
            ],
            "after": [
                "<C-u>",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "n"
            ],
            "after": [
                "n",
                "z",
                "z",
                "z",
                "v"
            ]
        },
        {
            "before": [
                "N"
            ],
            "after": [
                "N",
                "z",
                "z",
                "z",
                "v"
            ]
        },
        // ----- Window navigation -----
        {
            "before": [
                "<C-h>"
            ],
            "after": [
                "<C-w>",
                "h"
            ]
        },
        {
            "before": [
                "<C-j>"
            ],
            "after": [
                "<C-w>",
                "j"
            ]
        },
        {
            "before": [
                "<C-k>"
            ],
            "after": [
                "<C-w>",
                "k"
            ]
        },
        {
            "before": [
                "<C-l>"
            ],
            "after": [
                "<C-w>",
                "l"
            ]
        },
        // ----- Buffer navigation (LazyVim convention) -----
        {
            "before": [
                "]",
                "b"
            ],
            "commands": [
                "workbench.action.nextEditor"
            ]
        },
        {
            "before": [
                "[",
                "b"
            ],
            "commands": [
                "workbench.action.previousEditor"
            ]
        },
        // ----- Diagnostics -----
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        // ----- Git hunks -----
        {
            "before": [
                "]",
                "h"
            ],
            "commands": [
                "workbench.action.editor.nextChange"
            ]
        },
        {
            "before": [
                "[",
                "h"
            ],
            "commands": [
                "workbench.action.editor.previousChange"
            ]
        }
    ],
    // ===========================================================================
    // VIM — visual mode bindings
    // ===========================================================================
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": [
                ">"
            ],
            "after": [
                ">",
                "g",
                "v"
            ]
        },
        {
            "before": [
                "<"
            ],
            "after": [
                "<",
                "g",
                "v"
            ]
        }
    ],
    // ===========================================================================
    // VIM — insert mode bindings
    // ===========================================================================
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
