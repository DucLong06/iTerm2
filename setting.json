    // ===========================================================================
    // EDITOR SEMANTIC TOKEN COLORS (Cobalt2 customization — kept as-is)
    // ===========================================================================
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "class": {
                "foreground": "#FFC600",
                "fontStyle": "bold"
            },
            "struct": {
                "foreground": "#FFC600",
                "fontStyle": "bold"
            },
            "interface": {
                "foreground": "#FFC600",
                "fontStyle": "bold"
            },
            "enum": {
                "foreground": "#FF9D00",
                "fontStyle": "bold"
            },
            "type": {
                "foreground": "#FFC600"
            },
            "typeParameter": {
                "foreground": "#FFDD00"
            },
            "function": {
                "foreground": "#82AAFF",
                "fontStyle": "bold"
            },
            "function.unused": {
                "foreground": "#949494c7",
                "fontStyle": "strikethrough"
            },
            "method": {
                "foreground": "#82AAFF",
                "fontStyle": "bold"
            },
            "method.unused": {
                "foreground": "#3D4F5F",
                "fontStyle": "strikethrough"
            },
            "macro": {
                "foreground": "#FF9D00"
            },
            "decorator": {
                "foreground": "#FF9D00"
            },
            "parameter": {
                "foreground": "#FFD07B"
            },
            "parameter.unused": {
                "foreground": "#4D3D2F",
                "fontStyle": "strikethrough"
            },
            "variable": {
                "foreground": "#D4E8FF"
            },
            "variable.unused": {
                "foreground": "#3D4D5F",
                "fontStyle": "strikethrough"
            },
            "variable.readonly": {
                "foreground": "#80FFBB"
            },
            "variable.readonly.unused": {
                "foreground": "#2D4D3F",
                "fontStyle": "strikethrough"
            },
            "variable.defaultLibrary": {
                "foreground": "#FFC600"
            },
            "property": {
