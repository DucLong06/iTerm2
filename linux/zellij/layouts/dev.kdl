layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:$HOME/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode}#[bg=#1a1b26] {tabs}"
                format_right "#[bg=#1a1b26,fg=#565f89]{session} {datetime}"
                format_space "#[bg=#1a1b26]"
                mode_normal  "#[bg=#9ece6a,fg=#1a1b26,bold] NORMAL #[bg=#1a1b26,fg=#9ece6a]"
                mode_pane    "#[bg=#7aa2f7,fg=#1a1b26,bold] PANE #[bg=#1a1b26,fg=#7aa2f7]"
                mode_tab     "#[bg=#bb9af7,fg=#1a1b26,bold] TAB #[bg=#1a1b26,fg=#bb9af7]"
                mode_scroll  "#[bg=#2ac3de,fg=#1a1b26,bold] SCROLL #[bg=#1a1b26,fg=#2ac3de]"
                mode_session "#[bg=#ff9e64,fg=#1a1b26,bold] SESSION #[bg=#1a1b26,fg=#ff9e64]"
                tab_normal   "#[bg=#1a1b26,fg=#565f89] {index}:{name} "
                tab_active   "#[bg=#1a1b26,fg=#7aa2f7,bold] {index}:{name} "
                datetime "#[fg=#565f89,bg=#1a1b26] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Asia/Ho_Chi_Minh"
            }
        }
    }
    tab name="code" focus=true {
        pane split_direction="vertical" {
            pane command="nvim" size="70%"
            pane
        }
    }
    tab name="git" {
        pane command="lazygit"
    }
    tab name="shell"
}
