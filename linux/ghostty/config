# Cùng giao diện với mac/ghostty/config; chỉ bỏ các dòng chỉ có tác dụng trên macOS.

# === Theme: luôn tối (prompt p10k và shader con trỏ được chỉnh cho nền tối). Xem thử: ghostty +list-themes ===
theme = TokyoNight Night

# === Font === (Maple Mono NF, thiếu glyph thì lấy từ JetBrainsMono)
font-family = Maple Mono NF
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = -calt

# === Giao diện ===
window-padding-x = 15, 5
window-padding-y = 5, 15
window-padding-balance = false
split-divider-color = #202020
unfocused-split-opacity = 0.7
unfocused-split-fill = "#333333"
background-opacity = 0.92
# blur chỉ có tác dụng trên KDE; GNOME bỏ qua
background-blur = 20
# Thanh tiêu đề lấy đúng màu nền TokyoNight và không có bóng/viền ngăn với vùng terminal.
# KHÔNG dùng gtk-titlebar-style = tabs: tab chiếm gần hết thanh tiêu đề, kéo lên đó là kéo tab chứ không kéo cửa sổ
# (chỉ còn góc cạnh nút đóng là kéo được). native = thanh tiêu đề thường, tab nằm ở dòng riêng khi có >1 tab.
gtk-titlebar-style = native
# Dòng phụ dưới tiêu đề hiện thư mục hiện tại; tab gọn theo nội dung như Mac; phóng to thì ẩn titlebar cho rộng chỗ
window-subtitle = working-directory
gtk-wide-tabs = false
gtk-titlebar-hide-when-maximized = true
# Kích thước cửa sổ mới (số cột x số dòng)
window-width = 120
window-height = 34
window-theme = ghostty
gtk-toolbar-style = flat
# Thay cho font-thicken (chỉ macOS): bỏ hinting cho nét chữ đầy và mềm như trên Mac
freetype-load-flags = no-hinting

# === Con trỏ ===
cursor-style = bar
adjust-cursor-thickness = 4
cursor-opacity = 0.85
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always

# === Hành vi ===
scrollback-limit = 30000000
copy-on-select = clipboard
shell-integration-features = sudo,ssh-env,ssh-terminfo,title
mouse-hide-while-typing = true
confirm-close-surface = false
# Lệnh chạy quá 10s mà đang ở cửa sổ khác thì bắn thông báo desktop khi xong (cần shell-integration)
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# === Phím tắt ===
keybind = shift+enter=text:\x1b\r
# Ctrl+C copy khi đang bôi đen, không bôi đen thì vẫn gửi SIGINT như thường (performable)
keybind = performable:ctrl+c=copy_to_clipboard
# Gần giống Cmd+D / Cmd+Shift+D trên Mac. Không dùng Ctrl+D/Ctrl+W/Ctrl+V trơn: đó là EOF, xoá từ, visual-block của nvim
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+alt+d=new_split:down

# Quick terminal (Cmd+` trên Mac) cần Wayland layer-shell: chạy trên KDE/Hyprland/Sway, KHÔNG chạy trên GNOME.
# keybind = global:ctrl+grave_accent=toggle_quick_terminal

# (tuỳ chọn) shader con trỏ khác: shaders/{cursor_tail,ripple_cursor,sonic_boom_cursor,cursor_sweep}.glsl
# (tuỳ chọn) shader nền: shaders-bg/{bloom,starfield,just-snow,bettercrt,retro-terminal}.glsl
#            (bloom làm cháy trắng chữ nếu dùng theme sáng)
